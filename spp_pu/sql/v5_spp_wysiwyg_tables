-- 1. Tambah kolom detail ke tabel satker
ALTER TABLE satker
  ADD COLUMN IF NOT EXISTS nama_kementerian VARCHAR(100) DEFAULT 'Kementerian Pekerjaan Umum' AFTER nama,
  ADD COLUMN IF NOT EXISTS kode_kementerian VARCHAR(10)  DEFAULT '145'    AFTER nama_kementerian,
  ADD COLUMN IF NOT EXISTS nama_unit_org    VARCHAR(150) DEFAULT 'Direktorat Jenderal Prasarana Strategis' AFTER kode_kementerian,
  ADD COLUMN IF NOT EXISTS kode_unit_org    VARCHAR(10)  DEFAULT '06'     AFTER nama_unit_org,
  ADD COLUMN IF NOT EXISTS nama_provinsi    VARCHAR(100) DEFAULT 'DKI Jakarta' AFTER kode_unit_org,
  ADD COLUMN IF NOT EXISTS kode_provinsi    VARCHAR(10)  DEFAULT '01'     AFTER nama_provinsi,
  ADD COLUMN IF NOT EXISTS tempat           VARCHAR(100) DEFAULT 'Jakarta Selatan' AFTER kode_provinsi,
  ADD COLUMN IF NOT EXISTS alamat           VARCHAR(255) DEFAULT 'Jl. Pattimura No. 20 Kebayoran Baru Jakarta' AFTER tempat,
  ADD COLUMN IF NOT EXISTS kewenangan       VARCHAR(10)  DEFAULT 'KP'     AFTER alamat,
  ADD COLUMN IF NOT EXISTS nomor_dipa       VARCHAR(100) DEFAULT ''       AFTER kewenangan,
  ADD COLUMN IF NOT EXISTS tanggal_dipa     DATE         NULL             AFTER nomor_dipa,
  ADD COLUMN IF NOT EXISTS nama_penguji_spp VARCHAR(100) DEFAULT 'Mohammad Rival' AFTER tanggal_dipa,
  ADD COLUMN IF NOT EXISTS nama_ppk         VARCHAR(100) DEFAULT 'Citra Mayasari' AFTER nama_penguji_spp;

