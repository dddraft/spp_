-- 3. Tabel kegiatan (output kegiatan per program)
CREATE TABLE IF NOT EXISTS kegiatan (
  id           INT AUTO_INCREMENT PRIMARY KEY,
  satker_id    INT NOT NULL,
  program_id   INT NOT NULL,
  kode_kegiatan VARCHAR(20) NOT NULL,
  kode_output   VARCHAR(30) NOT NULL,
  nama_output   VARCHAR(255),
  pagu_output   BIGINT DEFAULT 0,
  is_aktif      TINYINT(1) DEFAULT 1,
  FOREIGN KEY (satker_id)  REFERENCES satker(id),
  FOREIGN KEY (program_id) REFERENCES program(id)
);

