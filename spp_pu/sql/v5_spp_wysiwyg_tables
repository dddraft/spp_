-- 5. Tabel surat_pp (dokumen SPP)
CREATE TABLE IF NOT EXISTS surat_pp (
  id                   INT AUTO_INCREMENT PRIMARY KEY,
  nomor_surat          VARCHAR(100),
  jenis_id             INT,
  satker_id            INT NOT NULL,
  tahun                YEAR,
  tanggal_surat        DATE,
  kode_program         VARCHAR(30),
  kode_kegiatan        VARCHAR(20),
  kode_output          VARCHAR(30),
  sub_komponen         VARCHAR(20),
  kode_akun            VARCHAR(10),
  uraian               TEXT,
  jumlah_uang          BIGINT DEFAULT 0,
  jenis_belanja_kode   VARCHAR(5),
  jenis_belanja_nama   VARCHAR(100),
  nama_penerima        VARCHAR(150),
  alamat_penerima      VARCHAR(255),
  bank_penerima        VARCHAR(100),
  no_rekening          VARCHAR(50),
  npwp                 VARCHAR(30),
  no_sk_spk            VARCHAR(100),
  tanggal_sk_spk       DATE NULL,
  nilai_spk            BIGINT DEFAULT 0,
  penjelasan           TEXT,
  doc_pendukung        INT DEFAULT 0,
  doc_surat_bukti      INT DEFAULT 0,
  doc_tanda_setoran    INT DEFAULT 0,
  bulan_gaji           VARCHAR(20),
  ke_gaji              INT DEFAULT 1,
  status               ENUM('draft','dikirim','diverifikasi','disetujui','ditolak','batal') DEFAULT 'draft',
  dibuat_oleh          INT,
  created_at           TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (satker_id) REFERENCES satker(id)
);

-- 6. Tabel surat_pp_akun (detail MAK per surat)
CREATE TABLE IF NOT EXISTS surat_pp_akun (
  id                 INT AUTO_INCREMENT PRIMARY KEY,
  surat_id           INT NOT NULL,
  tabel_type         ENUM('I','II') NOT NULL,
  kegiatan_akun_id   INT,
  kode_akun_lengkap  VARCHAR(60),
  pagu_dipa          BIGINT DEFAULT 0,
  spm_lalu           BIGINT DEFAULT 0,
  spp_ini            BIGINT DEFAULT 0,
  jumlah_sd_spp      BIGINT DEFAULT 0,
  sisa_dana          BIGINT DEFAULT 0,
  FOREIGN KEY (surat_id) REFERENCES surat_pp(id) ON DELETE CASCADE
);
